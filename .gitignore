# Root ignore rules for the Unity project under fps game/
# (The project also has its own fps game/.gitignore)

# OS / editor noise at repo root
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Unity generated folders (in case tools run from repo root)
fps game/[Ll]ibrary/
fps game/[Tt]emp/
fps game/[Oo]bj/
fps game/[Bb]uild/
fps game/[Bb]uilds/
fps game/[Ll]ogs/
fps game/[Uu]ser[Ss]ettings/
fps game/[Mm]emoryCaptures/
fps game/[Rr]ecordings/

# Autogenerated solution/project files at repo root
*.csproj
*.sln
*.user
*.userprefs
